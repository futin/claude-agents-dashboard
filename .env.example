# Claude Agents Dashboard — configuration
# Copy to .env and adjust. All values optional (defaults shown).

# Port the dashboard serves on.
PORT=4173

# Port the Vite dev UI serves on (`pnpm dev` only; prod ignores it). Set when
# another Vite project already occupies 5173.
# WEB_PORT=5173

# How many sessions to show, sorted by most-recent activity.
MAX_SESSIONS=5

# A session counts as "working" if its transcript changed within this many
# minutes; otherwise it is shown as "idle".
ACTIVE_WINDOW_MIN=5

# Only consider sessions whose transcript was modified within this many hours.
LOOKBACK_HOURS=24

# Skip the lsof process-liveness gate. Auto: true inside a Docker container
# (can't see the host's claude processes), false otherwise.
# SKIP_PROC_SCAN=false

# Optional: override the context-window size (tokens) used for the % bar.
# Leave unset to auto-detect (1M for Sonnet/Opus/Fable, 200k for Haiku + unknowns).
# NOTE: read straight off process.env (transcript.ts), NOT through this file —
# export it in the shell that starts the server.
# export CLAUDE_CODE_AUTO_COMPACT_WINDOW=400000

# Analytics tab: last N sessions you've run /kaizen on (read from
# ~/.claude/session-analytics-log.md). Set SHOW_ANALYTICS=false to hide the tab.
# SHOW_ANALYTICS=true
# ANALYTICS_KEEP=5

# Remote answers: let the chat drawer answer a session's AskUserQuestion.
# Needs the PreToolUse hook installed (see README). false → the toolbar pill
# reads "disabled" and every question goes to the terminal dialog as before.
# The toolbar toggle (persisted in .remote-answer.json) is the day-to-day switch;
# this is the hard kill switch.
# REMOTE_ANSWER=true

# Seconds of keyboard idle before you count as "away" (read by the hook, not the
# server). Below this, a question goes straight to the terminal dialog, so being
# at your desk behaves exactly as it did before the hook. 0 skips the check.
# NORMALLY LEAVE THIS UNSET. The hooks now read it off /api/health, so Settings →
# "Away after" drives it with no restart. Setting it here (or in the env block of
# ~/.claude/settings.json) wins and makes that control inert — the Settings page
# detects that and says so, but cannot clear it for you.
# CLAUDE_DASHBOARD_IDLE_SECS=60

# Seconds a question or plan stays answerable in the dashboard before the hook
# gives up and lets the terminal dialog appear. Same story as the threshold
# above: normally unset, driven by Settings → "Answer window". If you do raise it
# past ~600, also raise the `timeout` on the hook's entry in
# ~/.claude/settings.json to at least this + 15, or the CLI kills the hook
# mid-wait and the window silently shrinks.
# CLAUDE_DASHBOARD_ANSWER_TIMEOUT=600

# Shared secret for the two remote-answer POSTs. Empty = open, like every read
# endpoint here. Set it on a LAN you share, and put the same value in
# ~/.claude/hooks/dashboard-token so the hook can authenticate. Over Tailscale the
# tailnet is the perimeter (device identity), so this can stay empty unless you
# share the tailnet with other people — see docs/subsystems/remote-access.md.
# ANSWER_TOKEN=

# --- Push notifications (ntfy) -----------------------------------------------
# Pushes to your phone when a session needs you, so alerts arrive with the
# browser closed. Empty topic = the whole feature is off and the Settings group
# is disabled. Full walkthrough: docs/workflows/push-notify-setup.md
#
# TREAT THE TOPIC AS A SECRET. ntfy topics are unauthenticated, so the string is
# both the address and the credential: anyone who learns it can read your
# notifications AND publish to your phone. Make it long and unguessable
# (`openssl rand -hex 16`), not "claude-dashboard". No endpoint ever returns it.
# NTFY_TOPIC=

# Base URL of the ntfy server. Override for a self-hosted instance.
# NTFY_SERVER=https://ntfy.sh

# How your PHONE reaches this dashboard — used for the notification's
# tap-through link. Cannot be inferred: a push isn't triggered by a browser
# request, so there is no Host header to read. Set it to your tailnet hostname.
# Left unset it stays empty and pushes go out with no tap-through link at all —
# which the Test push button tells you, rather than guessing a localhost URL you
# never chose.
# DASHBOARD_PUBLIC_URL=http://your-host.your-tailnet.ts.net:4173

# --- Dictation (local whisper) ------------------------------------------------
# Mic button in the reply composer: records in the browser, transcribes locally
# with whisper.cpp. Empty model path = the whole feature is off, the same
# "unset means off" rule NTFY_TOPIC uses for pushes. Setup walkthrough:
# docs/workflows/dictation-setup.md
#
# Setting this arms POST /api/transcribe, which spawns processes on this
# machine — it's gated only by ANSWER_TOKEN above (empty there means this is
# open too). See docs/subsystems/dictation.md#security-posture before setting
# this on a machine other devices can reach.
# WHISPER_MODEL=/Users/you/.whisper/ggml-base.en.bin

# The whisper.cpp CLI. Default resolves from PATH; override for a non-PATH install.
# WHISPER_BIN=whisper-cli

# Transcodes the browser's recording to the 16kHz mono WAV whisper.cpp needs.
# Default resolves from PATH; override for a non-PATH install.
# FFMPEG_BIN=ffmpeg
