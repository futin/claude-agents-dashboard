# Claude Agents Dashboard — configuration
# Copy to .env and adjust. All values optional (defaults shown).

# Port the dashboard serves on.
PORT=4173

# Port the Vite dev UI serves on (`pnpm dev` only; prod ignores it). Set when
# another Vite project already occupies 5173.
# WEB_PORT=5173

# How many sessions to show, sorted by most-recent activity.
MAX_SESSIONS=5

# A session counts as "working" if its transcript changed within this many
# minutes; otherwise it is shown as "idle".
ACTIVE_WINDOW_MIN=5

# Only consider sessions whose transcript was modified within this many hours.
LOOKBACK_HOURS=24

# Skip the lsof process-liveness gate. Auto: true inside a Docker container
# (can't see the host's claude processes), false otherwise.
# SKIP_PROC_SCAN=false

# Optional: override the context-window size (tokens) used for the % bar.
# Leave unset to auto-detect (1M for Sonnet/Opus/Fable, 200k for Haiku + unknowns).
# NOTE: read straight off process.env (transcript.ts), NOT through this file —
# export it in the shell that starts the server.
# export CLAUDE_CODE_AUTO_COMPACT_WINDOW=400000

# Analytics tab: last N sessions you've run /kaizen on (read from
# ~/.claude/session-analytics-log.md). Set SHOW_ANALYTICS=false to hide the tab.
# SHOW_ANALYTICS=true
# ANALYTICS_KEEP=5

# Remote answers: let the chat drawer answer a session's AskUserQuestion.
# Needs the PreToolUse hook installed (see README). false → the toolbar pill
# reads "disabled" and every question goes to the terminal dialog as before.
# The toolbar toggle (persisted in .remote-answer.json) is the day-to-day switch;
# this is the hard kill switch.
# REMOTE_ANSWER=true

# Seconds of keyboard idle before you count as "away" (read by the hook, not the
# server). Below this, a question goes straight to the terminal dialog, so being
# at your desk behaves exactly as it did before the hook. 0 skips the check.
# CLAUDE_DASHBOARD_IDLE_SECS=60

# Shared secret for the two remote-answer POSTs. Empty = open, like every read
# endpoint here. Set it on a LAN you share, and put the same value in
# ~/.claude/hooks/dashboard-token so the hook can authenticate. Over Tailscale the
# tailnet is the perimeter (device identity), so this can stay empty unless you
# share the tailnet with other people — see .claude/rules/remote-access.md.
# ANSWER_TOKEN=
