# Claude Agents Dashboard — configuration
# Copy to .env and adjust. Every value is optional (defaults shown).
# Read once at startup — an edited .env needs a restart. Precedence:
# process.env > this file > server/lib/config.ts DEFAULTS.
#
# Full reference, including what each one costs you: docs/workflows/configuration.md
#
# NOT read from this file, though they look like they would be:
#   CLAUDE_DASHBOARD_IDLE_SECS, CLAUDE_DASHBOARD_ANSWER_TIMEOUT — hook-side. The
#     remote-answer hooks run inside Claude Code's process and read their own env.
#     Drive them from Settings → "Away after" / "Answer window" instead; setting
#     them in a shell or ~/.claude/settings.json wins and makes those controls inert.
#   CLAUDE_CODE_AUTO_COMPACT_WINDOW — read straight off process.env by
#     server/lib/transcript.ts. Export it in the shell that starts the server.

# Port the dashboard serves on.
PORT=4173

# Port the Vite dev UI serves on (`pnpm dev` only; prod ignores it). Defaults to
# 5174 rather than Vite's stock 5173, which is usually already taken.
# WEB_PORT=5174

# How many sessions to show, sorted by most-recent activity.
MAX_SESSIONS=5

# A session counts as "working" if its transcript changed within this many
# minutes; otherwise it is shown as "idle".
ACTIVE_WINDOW_MIN=5

# Only consider sessions whose transcript was modified within this many hours.
LOOKBACK_HOURS=24

# Skip the lsof process-liveness gate. Auto: true inside a Docker container
# (can't see the host's claude processes), false otherwise.
# SKIP_PROC_SCAN=false

# --- Usage bars ---------------------------------------------------------------
# Header usage bars. false skips the usage fetch and the keychain read entirely.
# SHOW_USAGE=true

# Renew an expired OAuth token by asking the CLI to, instead of showing the
# "token expired" hint. A kill switch, not a feature flag: renewal spawns
# `claude` and may spend one turn.
# USAGE_AUTO_REFRESH=true

# --- Remote answers -----------------------------------------------------------
# Let the chat drawer answer a session's AskUserQuestion. Needs the PreToolUse
# hook installed (see README). The hard kill switch in front of every write path;
# the toolbar toggle (.remote-answer.json) is the day-to-day one.
# REMOTE_ANSWER=true

# Shared secret for every write endpoint. Empty = open, like the read endpoints.
# Set it on a LAN you share, and put the same value in ~/.claude/hooks/dashboard-token
# so the hooks can authenticate. Over Tailscale the tailnet is the perimeter —
# see docs/subsystems/remote-access.md.
# ANSWER_TOKEN=

# --- Analytics ----------------------------------------------------------------
# Last N sessions you've run /kaizen on (read from ~/.claude/session-analytics-log.md).
# SHOW_ANALYTICS=true
# ANALYTICS_KEEP=5

# --- Push notifications (ntfy) ------------------------------------------------
# Pushes to your phone when a session needs you, so alerts arrive with the
# browser closed. Empty topic = the feature is off and the Settings group is
# disabled. Walkthrough: docs/workflows/push-notify-setup.md
#
# TREAT THE TOPIC AS A SECRET. ntfy topics are unauthenticated, so the string is
# both the address and the credential: anyone who learns it can read your
# notifications AND publish to your phone. Generate it (`openssl rand -hex 16`),
# don't name it "claude-dashboard". No endpoint ever returns it.
# NTFY_TOPIC=

# Base URL of the ntfy server. Override for a self-hosted instance.
# NTFY_SERVER=https://ntfy.sh

# How your PHONE reaches this dashboard — the notification's tap-through link.
# Cannot be inferred: a push has no Host header to read. Unset, pushes still
# arrive but tap through to nothing, which the Test push button tells you.
# DASHBOARD_PUBLIC_URL=http://your-host.your-tailnet.ts.net:4173

# Optional second topic for the DESK — a browser on this machine. Set it and a
# push raised while you're at the keyboard rings here instead of the phone; walk
# away past "Away after" and it goes back to the phone. Exclusive, never both.
#
# TREAT THIS TOPIC AS A SECRET TOO, and generate it separately — deriving it from
# NTFY_TOPIC (appending "-desk") means leaking one leaks the other.
# NTFY_TOPIC_DESK=

# How a browser ON THIS MACHINE reaches this server — the desk push's
# tap-through, which only hits /api/dismiss. Defaults to http://localhost:<PORT>,
# correct in dev too since that's an API route, not a page. Needs no tunnel and
# no DASHBOARD_PUBLIC_URL. Set only for a non-default host or port.
# DASHBOARD_LOCAL_URL=http://localhost:4173

# --- Dictation (local whisper) ------------------------------------------------
# Mic button in the reply composer: records in the browser, transcribes locally
# with whisper.cpp. Empty model path = the feature is off. Setup:
# docs/workflows/dictation-setup.md
#
# Setting this arms POST /api/transcribe, which spawns processes on this machine,
# gated only by ANSWER_TOKEN above (empty there means this is open too). Read
# docs/subsystems/dictation.md#security-posture before setting it on a machine
# other devices can reach.
# WHISPER_MODEL=/Users/you/.whisper/ggml-base.en.bin

# The whisper.cpp CLI and the transcoder to 16kHz mono WAV. Both resolve from
# PATH; override for a non-PATH install.
# WHISPER_BIN=whisper-cli
# FFMPEG_BIN=ffmpeg

# --- Spawn a session (headless claude -p) -------------------------------------
# Lets the dashboard start a new Claude Code session by launching a detached,
# headless `claude -p` on this machine. Empty (the default) disables the feature
# outright — there is no separate on/off flag.
# CLAUDE_BIN=claude

# The permission-mode ceiling every launch request is clamped to, whatever the
# form asks for. Ladder: plan < acceptEdits < auto < bypassPermissions.
#
# WARNING: bypassPermissions lets anything that can reach the spawn endpoint run
# an unsandboxed `claude` process here with no permission prompts at all. Only
# raise it on a machine and network you fully trust — docs/subsystems/remote-access.md.
# SPAWN_MAX_PERMISSION=auto
